Options -Indexes
DirectoryIndex index.php

<FilesMatch "^(config\\.php|\\.env|PROJECT-CONTEXT\\.md)$">
  Require all denied
</FilesMatch>

RewriteEngine On

# Keep static assets directly served; route all application URLs through the
# explicit allowlist dispatcher. The router itself must not be rewritten.
RewriteRule ^assets/ - [L]
RewriteRule ^router\\.php$ - [L]
RewriteRule ^ router.php [QSA,L]
